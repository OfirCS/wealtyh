# Pathfinder runs with no keys at all, using its built-in Canadian planner.
# Add a key to turn on the live agent.

# Claude: runs plans, live web search, and reading email and PDF statements
ANTHROPIC_API_KEY=

# Turns on "Connect Gmail". Free to create, see "Turn on Gmail" in the README.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Turns on "Connect bank". Free Trial covers 10 real logins: dashboard.plaid.com/trial-plan
PLAID_CLIENT_ID=
PLAID_SECRET=
# sandbox or production
PLAID_ENV=sandbox

# Needed once this runs anywhere but your own machine
# Postgres. Left empty, PGlite keeps everything in .data/
DATABASE_URL=
# 32 random bytes in base64: openssl rand -base64 32
SESSION_SECRET=
# Same again. Seals bank tokens, so changing it means everyone reconnects.
TOKEN_KEY=
# The public https address, for Plaid webhooks and the Wallet shortcut
PUBLIC_URL=
CRON_SECRET=

# Shown on the privacy and terms pages. Google and Plaid both expect a contact.
NEXT_PUBLIC_CONTACT_EMAIL=

# Keeps the whole site private behind one password. Leave empty to open it.
SITE_PASSWORD=

# Set to on for a host with a short request limit. Plans then skip live search and draft in fast mode.
PLAN_QUICK=

# Switches plans on. Until all four are set, everyone gets Family free.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=

# Optional. When set, live search uses Google grounding instead of Claude's web search.
GOOGLE_API_KEY=

# Optional: rate-limit tuning (defaults shown)
RATE_LIMIT_PER_IP_DAILY=20
RATE_LIMIT_GLOBAL_DAILY=1000


# A shared iCloud shortcut for Apple Wallet. Without it, the Wallet panel shows the steps by hand.
NEXT_PUBLIC_WALLET_SHORTCUT=
